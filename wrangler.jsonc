{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noble-filter-lists",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "filters.matthewnoble.au",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}

